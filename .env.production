# Production / staging builds call the same origin that served the page.
# The Worker on that hostname forwards /api/* to Rails and /api/music-gen/* to music-gen.
# Leaving these blank (or deleting them) is the safe default: an absolute host
# would be inlined into the JS bundle, and a login cookie for one hostname
# would not be sent to another.
#
# `npm start` does not read this file. Put absolute URLs in gitignored `.env`
# when the dev server should call a remote backend.
#
# A one-off production build can still override these — shell variables and
# gitignored `.env.production.local` both win over this file:
#   REACT_APP_ANALYSIS_API_BASE=https://backend.example
#   REACT_APP_MUSIC_GEN_URL=https://backend.example/api/music-gen
REACT_APP_ANALYSIS_API_BASE=
REACT_APP_MUSIC_GEN_URL=
